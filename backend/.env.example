# ==============================
# Configuration du serveur
# ==============================
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173

# ==============================
# Base de donnees PostgreSQL
# ==============================
# Renseigne ces valeurs selon ton installation PostgreSQL locale ou ton serveur de production.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fitahiantsoa
DB_USER=postgres
DB_PASSWORD=changeme

# ==============================
# Securite / JWT
# ==============================
# IMPORTANT : remplace ces valeurs par des chaines aleatoires longues en production.
# Tu peux en generer avec : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=remplace_moi_par_une_chaine_aleatoire_longue
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=remplace_moi_aussi_par_une_autre_chaine_aleatoire
JWT_REFRESH_EXPIRES_IN=30d

# ==============================
# Upload de fichiers
# ==============================
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5

# ==============================
# Compte administrateur initial (cree au seed)
# ==============================
ADMIN_EMAIL=admin@fitahiantsoa.mg
ADMIN_PASSWORD=ChangeMoi123!
ADMIN_CIN=000000000000
